            "label": "2026-05-27_19-40-54",
            "content": "package main\nimport \"fmt\"\n\nfunc Quadrado(n int) int {\n    if n == 1 {\n        fmt.Println(\"1^2 = 1\")\n        return 1\n    }\n\n    fmt.Printf(\"%d^2 = %d^2 + 2*%d + 1 = ?\\n\", n, n-1, n-1)\n\n    anterior := Quadrado(n-1)\n    result := anterior + 2*(n-1) + 1\n\n    fmt.Printf(\"%d^2 = %d^2 + 2*%d + 1 = %d\\n\", n, n-1, n-1, result)\n    return result\n}\n\nfunc main() {\n    n := 0\n\n    fmt.Scan(&n)\n\n    Quadrado(n)\n}\n",
